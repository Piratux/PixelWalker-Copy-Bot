{
  "name": "pixelwalker-copy-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "coverage": "vitest --coverage.enabled=true",
    "build": "vite build && bun run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview",
    "format": "bunx prettier . --write --ignore-pattern dist",
    "lint": "bunx eslint . --fix --ignore-pattern dist",
    "ts-check": "vue-tsc --noEmit",
    "check-dependencies": "bunx npm-check-updates",
    "update-dependencies-all": "bunx npm-check-updates -u && bun install",
    "update-dependencies-interactive": "bunx npm-check-updates -i",
    "gen-files": "bunx tsx src/script/GenerateBlockEnumFiles.ts",
    "gen-tests": "bunx tsx src/script/GenerateTests.ts",
    "bombot": "vite-node --config vite.config.cli.ts src/cli/BomBotCli.ts"
  },
  "dependencies": {
    "@basementuniverse/vec": "^2.5.1",
    "@mdi/font": "^7.4.47",
    "@tonejs/midi": "^2.0.28",
    "eslint-plugin-vue": "^10.12.0",
    "github-markdown-css": "^5.9.0",
    "iconv-lite": "^0.7.3",
    "lodash-es": "^4.18.1",
    "many-keys-map": "^3.0.3",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "playerioclient": "^1.0.7",
    "pngjs": "^7.0.0",
    "pw-js-api": "0.3.23",
    "pw-js-world": "0.5.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1",
    "worker-timers": "^8.0.34"
  },
  "engines": {
    "node": ">=24.9.0",
    "bun": "1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged && bun run ts-check"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ]
  }
}
